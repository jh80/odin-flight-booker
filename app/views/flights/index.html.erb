<h1>Welcome to Flight Booker!</h1>

<%# built without form_with, a basic html form %>
<form action="/flights" method="get" accept-charset="UTF-8">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

    <select name="query[departure_airport_id]">
        <% @airports.each do |airport| %>
            <option value="<%= airport.id %>"><%= airport.code %></option>
        <% end %>
    </select>

    <select name="query[arrival_airport_id]">
        <% @airports.each do |airport| %>
            <option value="<%= airport.id %>"><%= airport.code %></option>
        <% end %>
    </select>

    <select name="query[num_tickets]">
        <% (1..4).each do |num| %>
            <option value="<%= num %>"><%= num %></option>
        <% end %>
    </select>

    <select name ="query[date]">
        <% @date_options.each do | namval | %>
            <option value="<%= namval[1] %>"><%= namval[0] %></option>
        <% end %>
    </select>

    <%#= select_tag(params[:query][date], options_for_select(@date_options)) %>

    <%# Alternate date dropdowns %>
    <%#= select_month(Date.today) %>
    <%#= date_select("flight", "date")%>
    <%#= datetime_select("flight", "date") %>
    <%# <select name="> %>

    <input type="submit" value="Search" name="commit">
</form>